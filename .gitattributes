# Docker / 容器 / 脚本文件强制使用 LF（避免 Unix 环境下执行异常）
Dockerfile           text eol=lf
.dockerignore        text eol=lf
.gitattributes       text eol=lf
*.sh                 text eol=lf
*.js                 text eol=lf
*.json               text eol=lf
*.md                 text eol=lf
*.html               text eol=lf
*.yml                text eol=lf
*.yaml               text eol=lf
LICENSE              text eol=lf

# Windows 专属文件保留 CRLF
*.bat                text eol=crlf
*.cmd                text eol=crlf
